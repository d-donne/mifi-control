{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc",
    "eslint",
    "unicorn",
    "import",
    "react",
    "promise"
  ],
  "jsPlugins": ["eslint-plugin-expo"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [".expo/**", "*.d.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "expo/no-env-var-destructuring": "error",
    "expo/no-dynamic-env-var": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-named-as-default-member": "off",
    "unicorn/prefer-add-event-listener": "off",
    "promise/always-return": "off",
    "no-underscore-dangle": [
      "warn",
      { "allow": ["__RequestVerificationToken"] }
    ],
    "react/style-prop-object": ["warn", { "allow": ["StatusBar"] }]
  },
  "overrides": [
    {
      "files": ["*.tsx"],
      "rules": {
        "import/no-unassigned-import": [
          "warn",
          { "allow": ["**/*.css", "**/*.scss", "**/*.sass", "**/*.less"] }
        ]
      }
    },
    {
      "files": ["./components/ui/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "allow",
        "typescript/no-unnecessary-type-assertion": "allow",
        "typescript/consistent-return": "allow"
      }
    },
    {
      "files": ["./src/api/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "allow"
      }
    }
  ]
}

    "babel-plugin-module-resolver": "^5.0.0",
    "eslint-plugin-expo": "^1.2.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2"

    "ios": "expo run:ios",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prebuild": "expo prebuild --clean",
    "start": "expo start",
    "update": "sh scripts/publish-update.sh",
    "web": "expo start --web"
